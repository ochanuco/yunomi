{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "/usr/local/bin/node /opt/yunomi-guard/hook.ts",
						"timeout": 30
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/usr/local/bin/node /opt/yunomi-repo-map/hook.ts",
						"timeout": 30
					}
				]
			}
		],
		"PermissionDenied": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "/usr/local/bin/node /opt/yunomi-guard/hook.ts",
						"timeout": 30
					}
				]
			}
		]
	},
	"env": {
		"ENABLE_TOOL_SEARCH": "false"
	},
	"allowManagedHooksOnly": true,
	"allowManagedPermissionRulesOnly": true,
	"disableAllHooks": false,
	"permissions": {
		"disableBypassPermissionsMode": "disable"
	}
}
