{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!**/migrations",
			"!**/.cloudflare",
			"!**/worker-configuration.d.ts",
			"!**/generated"
		]
	},
	"formatter": { "indentStyle": "tab" },
	"linter": { "enabled": true },
	"plugins": [
		{
			"path": "biome-plugins/no-json-stringify.grit",
			"includes": [
				"**/packages/conversation/src/**",
				"**/packages/capabilities/src/gate.ts",
				"!**/*.test.ts",
				"!**/test-fixtures.ts"
			]
		},
		{
			"path": "biome-plugins/no-format-jst.grit",
			"includes": [
				"**/packages/conversation/src/**",
				"**/packages/capabilities/src/gate.ts",
				"!**/*.test.ts",
				"!**/test-fixtures.ts"
			]
		},
		{
			"path": "biome-plugins/no-to-iso-string.grit",
			"includes": [
				"**/packages/conversation/src/**",
				"**/packages/capabilities/src/gate.ts",
				"!**/*.test.ts",
				"!**/test-fixtures.ts"
			]
		}
	]
}
